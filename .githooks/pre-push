#!/bin/sh
# Refuse a red push. Versioned, because a hook in .git/hooks exists on exactly one
# machine and is invisible to review — this one is set up with
#
#   git config core.hooksPath .githooks
#
# which bootstrap.py does, and tests/test_pre_push_hook.py asserts.
#
# Measured cost: about 100s cold, 12s when nothing has changed, because the gate skips
# steps whose inputs are unchanged since the last green run.
#
# There is no escape hatch. One used to exist here (SF_SKIP_GATE) and an agent used
# it on 20 Sep 2026 to push a red gate — see HANDOFF.md, task 40. It is removed, not
# disabled: the only way past this hook is a green run of scripts/ci.py.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PYTHON=".venv/Scripts/python.exe"
[ -x "$PYTHON" ] || PYTHON=".venv/bin/python"
[ -x "$PYTHON" ] || PYTHON="python"

echo "pre-push: running the CI mirror gate..."
if ! "$PYTHON" scripts/ci.py; then
  echo ""
  echo "pre-push: REFUSED. The gate is red — the failing step is named above."
  echo "pre-push: fix it. There is no skip."
  exit 1
fi
